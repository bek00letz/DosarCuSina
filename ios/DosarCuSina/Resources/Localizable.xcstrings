    "Rezolvat": {
      "comment": "Status or badge of an obligation that has been completed."
    },
    "Scrie doar cifre, de exemplu 84.200.": {
      "comment": "Validation message when a reading such as kilometers isn't a number."
    },
    "Scrie suma doar cu cifre, de exemplu 1.250,50.": {
      "comment": "Validation message when a money amount isn't a number."
    },
    "Se încarcă…": {
      "comment": "Shown or read by VoiceOver while content loads."
    },
    "Seria de șasiu din talon, 17 litere și cifre.": {
      "comment": "VoiceOver hint for the vehicle identification number field."
    },
    "Stradă, număr, localitate": {
      "comment": "Placeholder for an address field."
    },
    "Suma nu poate fi negativă.": {
      "comment": "Validation message when a money amount is below zero."
    },
    "Un link care începe cu https.": {
      "comment": "VoiceOver hint for a web link field."
    },
    "Un număr de telefon.": {
      "comment": "VoiceOver hint for a phone number field."
    },
    "Valabil": {
      "comment": "Badge: a document is valid and not close to expiring."
    },
    "În curând": {
      "comment": "Status of an obligation due within the next days."
    },
    "Încearcă din nou": {
      "comment": "Button on an error screen that retries the failed action."
    },
    "Închide": {
      "comment": "VoiceOver action that dismisses a toast."
    },
