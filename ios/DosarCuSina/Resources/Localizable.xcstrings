    "Anulează": {
      "comment": "Button that closes an editing sheet, or reverses the action a toast confirms."
    },
    "Azi": {
      "comment": "Badge: the obligation is due today."
    },
    "Categoria are încă %lld active. Mută-le sau șterge-le mai întâi.": {
      "comment": "Shown when deleting a category that still has assets",
      "localizations": {
        "ro": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Categoria are încă %lld activ. Mută-l sau șterge-l mai întâi."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Categoria are încă %lld active. Mută-le sau șterge-le mai întâi."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Categoria are încă %lld de active. Mută-le sau șterge-le mai întâi."
                }
              }
            }
          }
        }
      }
    },
    "Ce ai completat până acum nu se va salva.": {
      "comment": "Explains what discarding unsaved changes means."
    },
    "Cele 15 cifre ale microcipului, din carnetul de sănătate.": {
      "comment": "VoiceOver hint for the pet microchip field."
    },
    "Completează acest câmp.": {
      "comment": "Validation message under a required field that was left empty."
    },
    "Continuă editarea": {
      "comment": "Button that keeps the sheet open."
    },
    "Contul bancar, începe cu RO.": {
      "comment": "VoiceOver hint for the IBAN field."
    },
    "Elimină contactul": {
      "comment": "Menu item that unlinks the contact from this field."
    },
    "Expiră azi": {
      "comment": "Badge: a document expires today."
    },
    "Mai târziu": {
      "comment": "Status of an obligation that is not due soon."
    },
    "Monedă": {
      "comment": "Label of the currency picker next to an amount."
    },
    "Mâine": {
      "comment": "Badge: the obligation is due tomorrow."
    },
    "Niciuna": {
      "comment": "Choice that leaves an optional field empty."
    },
    "Nimic ales": {
      "comment": "VoiceOver value of an empty choice field."
    },
    "Numărul de înmatriculare, de exemplu B 123 ABC.": {
      "comment": "VoiceOver hint for the license plate field."
    },
    "O adresă de e-mail.": {
      "comment": "VoiceOver hint for an email field."
    },
    "Opțiuni contact": {
      "comment": "VoiceOver label of the menu next to a linked contact."
    },
    "Renunți la modificări?": {
      "comment": "Title of the dialog shown when closing a sheet with unsaved changes."
    },
    "Renunță la modificări": {
      "comment": "Destructive button that closes the sheet and drops unsaved changes."
    },
    "Revizie: %lld lucrări": {
      "comment": "History entry title for a visit with many jobs",
      "localizations": {
        "ro": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Revizie: %lld lucrare"
