    "În %lld zile: %@": {
      "comment": "Reminder title, due in N days. The second value is the obligation title.",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În %#@days@: %2$@"
          },
          "substitutions": {
