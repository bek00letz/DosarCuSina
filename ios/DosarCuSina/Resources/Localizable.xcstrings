{
  "sourceLanguage": "ro",
  "strings": {
    "%@, în %lld zile": {
      "comment": "Siri answer: the obligation title, then in how many days it is due.",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, în %#@days@"
          },
          "substitutions": {
            "days": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg zi"
                    }
                  },
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg zile"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg de zile"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "15 cifre": {
      "comment": "Placeholder for the pet microchip field."
    },
    "17 litere și cifre": {
      "comment": "Placeholder for the vehicle identification number field."
    },
    "Adaugă data": {
      "comment": "Button in an empty date field."
    },
    "Adresa completă.": {
      "comment": "VoiceOver hint for an address field."
    },
    "Ai o scadență în %lld zile": {
