    },
    "În curând": {
      "comment": "Status of an obligation due within the next days."
    },
    "Încearcă din nou": {
      "comment": "Button on an error screen that retries the failed action."
    },
    "Închide": {
      "comment": "VoiceOver action that dismisses a toast."
    },
    "Întârziat": {
      "comment": "Status of an obligation whose due date has passed."
    },
    "Întârziat cu %lld zile": {
