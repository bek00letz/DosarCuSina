{
  "sourceLanguage" : "ro",
  "strings" : {
    "„%@”" : {
      "comment" : "Repair: where a day is kept, with no section.\nThe name a moved document would take."
    },
    "„%@” apare de mai multe ori în Agendă (același nume sau același CUI). Le unesc într-una?" : {
      "comment" : "Repair: the same firm kept twice."
    },
    "„%@” are factura din %@ de mai multe ori în Istoric. O las o singură dată?" : {
      "comment" : "Repair: the same bill logged more than once in a subscription's history.",
      "localizations" : {
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "„%1$@” are factura din %2$@ de mai multe ori în Istoric. O las o singură dată?"
          }
        }
      }
    },
    "„%@” din %@ e încă legat de locul de unde l-ai mutat. Îl dezleg de acolo?" : {
      "comment" : "Repair: a moved document keeps links to its old place.",
      "localizations" : {
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "„%1$@” din %2$@ e încă legat de locul de unde l-ai mutat. Îl dezleg de acolo?"
          }
        }
      }
    },
    "„%@” e bun de călătorit doar până pe %@, cu %@ înainte să expire. Schimb când te anunț? %@" : {
      "comment" : "Repair: a passport deadline gets the day it stops being good for travel, and reminders counted from it. Ends with the new reminder sentence.",
      "localizations" : {
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "„%1$@” e bun de călătorit doar până pe %2$@, cu %3$@ înainte să expire. Schimb când te anunț? %4$@"
          }
        }
      }
    },
    "„%@” e prea mare pentru o copie de siguranță. Scoate-l din dosar și păstrează-l în altă parte, apoi fă copia din nou." : {
      "comment" : "Backup: one document is larger than a backup's file may be. The argument is the document's title."
    },
    "„%@” e protejat" : {
      "comment" : "Title of a locked section. The name is the section's."
    },
    "„%@” e un exemplu. Adaugă în altă secțiune sau păstrează exemplul ca al tău." : {

    },
    "„%@” într-o singură cutie" : {
      "comment" : "Setting: show all of a category's sections (Mașini) in one box on the binder."
    },
    "„%@” la %@ a venit dintr-o copie de siguranță veche, fără regula lui. Îi pun regula obișnuită?" : {
      "comment" : "Repair: a deadline from a first-version backup gets its blueprint and rule.",
      "localizations" : {
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "„%1$@” la %2$@ a venit dintr-o copie de siguranță veche, fără regula lui. Îi pun regula obișnuită?"
          }
        }
      }
    },
    "„%@” la %@ pare închis de două ori, la câteva zile distanță. Anulez a doua oară?" : {
      "comment" : "Repair: a deadline closed twice by an old reminder.",
      "localizations" : {
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "„%1$@” la %2$@ pare închis de două ori, la câteva zile distanță. Anulez a doua oară?"
          }
        }
      }
    },
    "„%@” nu s-a amânat" : {
      "comment" : "Urmează: a snooze from a reminder couldn't be saved"
    },
    "„%@” nu s-a bifat" : {
      "comment" : "Urmează: a reminder button or widget tap for this deadline couldn't be saved"
    },
    "„%@” păstrează un număr de card întreg. Păstrez doar ultimele patru cifre?" : {
      "comment" : "Repair: a whole bank card number kept in a section's, a firm's or a category's text."
    },
