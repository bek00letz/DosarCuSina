<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Nothing leaves the phone yet: no library may add the internet. The optional AI
         provider brings it in a later phase, and that change removes this line. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!-- Backups: never Android's automatic cloud backup (25 MB per app would bring a
         binder back without its documents); phone-to-phone transfer brings it all.
         The way off the phone is a .dosar copy (docs/DECISIONS.md, 2026-11-25). -->
    <!-- The app opens the binder as it starts (DosarApplication) and writes Romanian on every
         phone (localeConfig: its one language). -->
    <application
        android:name=".DosarApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dosar"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
