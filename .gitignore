# ==========================================
# Dosar cu Șină — Git Ignore Policy
# Public Repository Safe: ZERO SECRETS / ZERO PERSONAL DATA
# ==========================================

# OS & Finder
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# Secrets, Environment & API Keys (CRITICAL)
*.env
*.env.*
*.secret
*.secrets
*.xcconfig
!*.xcconfig.template
Secrets.swift
Secrets.kt
local.properties
keystore.properties
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision
GoogleService-Info.plist
google-services.json

# Confidential Security Vault & Private Development Logs (CRITICAL)
# Documents in these folders contain vulnerability findings, bug reports, and internal notes.
# scripts/privacy-check.sh blocks the same paths; keep the two lists in step.
private/
.private/
internal/
.internal/
security-vault/
.agents/
*.private.*
*.internal.*
*VULNERABILIT*
*EXPLOIT*

# Xcode & Apple Build Artifacts
build/
DerivedData/
*.moved-aside
*.xcuserstate
*.xccheckout
*.xcscmblueprint
xcuserdata/
*.xcuserdatad/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Swift Package Manager
.build/
Packages/
Package.pins
Package.resolved

# Fastlane & App Store
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# Android / Gradle (Future-proofing)
.gradle/
*/build/
captures/
*.apk
*.aab
.idea/
*.iml

# Node / Web / Docs caches (if any)
node_modules/
.npm
dist/
.temp/
tmp/
